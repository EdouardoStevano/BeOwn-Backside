# ── Database ──────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DATABASE_DB=beown

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Project share token (random 32-byte hex; rotate to invalidate all existing share links) ──
PROJECT_SHARE_SECRET=change-me-to-a-long-random-hex

# ── JWT ───────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TOKEN_AUDIENCE=localhost:3001
JWT_TOKEN_ISSUER=localhost:3001
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
# In seconds. 86400 = 24h — matches the real deployed value (see .env) and
# the "email-token TTL is at most 24h" assumption baked into the
# email_verify/password_reset token-confusion guards (reset-password.usecase.ts,
# verify-email.service.ts).
JWT_TOKEN_EMAIL_TTL=86400

# ── OTP (2FA login codes — otp.controller.ts) ─────
OTP_TTL=300 # in seconds (5 min)
MAX_ATTEMPTS=5

# ── Registration OTP (signup verification — /auth/verify-otp) ──
# Its own TTL, deliberately separate from OTP_TTL above (different flow,
# different Redis key namespace: registration-otp-* vs otp:email:*/otp:sms:*).
REGISTRATION_OTP_TTL=600 # in seconds (10 min)

# ── Mail (Nodemailer fallback) ────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_USER_PASSWORD=your-app-password
MAIL_FROM=no-reply@beown.fr

# ── Brevo (Sendinblue) ───────────────────────────
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=no-reply@beown.fr
BREVO_SENDER_NAME=BeOwn

# ── Twilio SMS ────────────────────────────────────
# All three required for real sending (SMS_SERVICE, sms.module.ts). If any
# is missing, the app falls back to NoopSmsService (logs only, dev/CI safe —
# never throws, never sends).
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Stripe ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── OAuth Social Providers ────────────────────────
# Optional: dedicated secret for signing the OAuth state cookie (CSRF protection).
# If unset, falls back to JWT_SECRET.
# OAUTH_STATE_SECRET=change-me-to-a-long-random-secret
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

FACEBOOK_CLIENT_ID=xxx
FACEBOOK_CLIENT_SECRET=xxx
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

LINKEDIN_CLIENT_ID=xxx
LINKEDIN_CLIENT_SECRET=xxx
LINKEDIN_CALLBACK_URL=http://localhost:3001/auth/linkedin/callback

# ── App ───────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
TFA_APP_NAME=BeOwn
TFA_SECRET_ENCRYPTION_KEY=change-me-to-a-32-byte-random-secret

# ─── PSFP / Regulation ───────────────────────────────────
PLAFOND_INVESTISSEMENT_NON_AVERTI_EUR=1000
PLAFOND_INVESTISSEMENT_AVERTI_EUR=100000

# ─── KYC / Compliance ────────────────────────────────────
KYC_PROVIDER=stripe  # stripe (Stripe Identity) | manual (fallback validé par l'admin)
