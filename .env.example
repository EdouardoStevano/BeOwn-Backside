# ── Database ──────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DATABASE_DB=beown
# Taille maximale du pool de connexions PostgreSQL, PAR PROCESSUS.
# Défaut 10 (celui de `pg`, jusqu'ici subi et invisible depuis la config).
#
# RÈGLE : répliques maximales × PG_POOL_MAX <= max_connections de PostgreSQL,
# marge comprise pour l'administration, les sauvegardes et le cron.
# En cluster : HPA à 6 répliques × 10 = 60, sous le max_connections par défaut
# de 100. Augmenter ce pool sans augmenter max_connections transforme un pic
# de trafic en « sorry, too many clients already » — une panne totale, y
# compris pour les pods qui n'ont rien demandé.
PG_POOL_MAX=10

# ── Redis ─────────────────────────────────────────
# Sert aussi de stockage partagé aux compteurs de limitation de débit.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Limitation de débit (throttling) ──────────────
# Deux filets GLOBAUX appliqués à TOUTES les routes, vitrine publique comprise.
# Valeurs par défaut = celles qui étaient écrites en dur dans app.module.ts ;
# elles ne sont surchargées ici que pour resserrer (attaque en cours) ou
# desserrer (pic de trafic légitime) sans réimager le service.
# Une valeur présente mais non entière ou <= 0 FAIT ÉCHOUER LE DÉMARRAGE :
# une limite qu'on croit appliquée et qui est retombée en silence sur son
# défaut est pire que pas de limite du tout.
#
# ⚠ Ces limites sont comptées PAR SEAU (utilisateur authentifié, sinon IP) et
# partagées entre réplicas via Redis. Les dimensionner en req/s réellement
# attendues sur le pic, jamais « au cas où ».
THROTTLE_SHORT_TTL=1000      # fenêtre courte, en ms
THROTTLE_SHORT_LIMIT=500     # requêtes autorisées par fenêtre courte
THROTTLE_MEDIUM_TTL=60000    # fenêtre moyenne, en ms
THROTTLE_MEDIUM_LIMIT=2000   # requêtes autorisées par fenêtre moyenne
#
# Le palier `auth` (bourrage d'identifiants) n'est PAS configurable ici : il
# n'est plus global depuis la passe 4 et vit sur les routes qui le posent
# (`@Throttle({ auth: … })` sur sign-in, OTP, reset, MFA). Déclaré
# globalement, il refusait 97,8 % du trafic anonyme dès 34 req/s.

# ── Reverse proxy ─────────────────────────────────
# Nombre de proxys de confiance devant l'application (ingress, LB, CDN).
# 0 (défaut) = exposition directe, X-Forwarded-For ignoré.
# En production derrière un ingress : 1. Ne jamais surestimer cette valeur,
# un client pourrait alors falsifier son IP et contourner la limitation.
TRUST_PROXY_HOPS=0

# ── Project share token (random 32-byte hex; rotate to invalidate all existing share links) ──
PROJECT_SHARE_SECRET=change-me-to-a-long-random-hex

# ── JWT ───────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TOKEN_AUDIENCE=localhost:3001
JWT_TOKEN_ISSUER=localhost:3001
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
# In seconds. 86400 = 24h — matches the real deployed value (see .env) and
# the "email-token TTL is at most 24h" assumption baked into the
# email_verify/password_reset token-confusion guards (reset-password.usecase.ts,
# verify-email.service.ts).
JWT_TOKEN_EMAIL_TTL=86400
# Exige le claim `type` ('access' / 'refresh') sur les jetons de session.
# `true` (défaut, fail-closed) : les jetons émis AVANT l'ajout de l'estampille
# sont refusés — les sessions ouvertes au moment du déploiement doivent se
# réauthentifier. Le passer à `false` LE TEMPS D'UN DÉPLOIEMENT évite cette
# déconnexion, mais réexpose la confusion access/refresh pour les jetons
# antérieurs, au plus pendant un TTL de refresh. Remettre `true` ensuite.
JWT_REQUIRE_TYPE_CLAIM=true

# ── Version des CGU en vigueur ────────────────────
# Version ARCHIVÉE comme preuve de consentement à l'inscription
# (`users.cguVersionAcceptee`, art. 7.1 RGPD). Décidée par le SERVEUR : le
# champ `cguVersion` du corps de `POST /auth/sign-up` n'est plus qu'un contrôle
# de cohérence (divergence journalisée, jamais rejetée). Vide ou absente, la
# constante `CGU_VERSION_PAR_DEFAUT` du code fait foi.
# MIROIR : « BeOwn - Frontside/src/core/config/cguVersion.ts ».
CGU_VERSION_COURANTE=1.1

# ── Taux de change (proxy serveur) ────────────────
# Clé SERVEUR du fournisseur de taux (v6.exchangerate-api.com), consommée par
# `GET /public/exchange-rates`. Elle vivait dans une variable VITE_* du front,
# INLINÉE dans le bundle au build — donc lisible par quiconque ouvrait les
# sources de la page, et utilisable jusqu'à épuisement du quota du compte.
# Absente : la route rend 503 et le front garde ses taux de repli (mode
# dégradé assumé — la plateforme compte en euros).
EXCHANGE_RATE_API_KEY=

# ── OTP (2FA login codes — otp.controller.ts) ─────
OTP_TTL=30 # in seconds
MAX_ATTEMPTS=5

# ── Mail : trois drivers ──────────────────────────
# `mailpit`    dev : capture tout, rien ne sort
# `nodemailer` SMTP réel (variables MAIL_HOST/PORT/USER/USER_PASSWORD)
# `brevo`      API HTTP Brevo — implémenté mais compte non opérationnel
# Vide = auto : nodemailer si NODE_ENV vaut development, staging ou production
# (environnements déployés), mailpit partout ailleurs — dont le poste local,
# qui ne définit pas NODE_ENV.
MAIL_DRIVER=
# API HTTP de Mailpit — doit correspondre au port publié par docker-compose.
MAILPIT_URL=http://localhost:8025

# ── SMTP (driver nodemailer) ─────────────────────
# Port 465 = TLS implicite, 587 = STARTTLS. Sur Gmail, MAIL_USER_PASSWORD doit
# être un « mot de passe d'application », pas le mot de passe du compte.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_USER_PASSWORD=
# Expéditeur des drivers mailpit et nodemailer (brevo utilise
# BREVO_SENDER_EMAIL). Écrasé par l'expéditeur configuré côté admin s'il existe.
MAIL_FROM=no-reply@beown.local
MAIL_FROM_NAME=BeOwn

# ── Brevo (Sendinblue) ───────────────────────────
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=no-reply@beown.fr
BREVO_SENDER_NAME=BeOwn

# ── SMS : deux drivers ────────────────────────────
# `log` (dev : rien ne sort, le code OTP est écrit dans les logs) | `twilio`
# (envois réels, facturés).
# Vide = auto : log hors production, twilio si NODE_ENV=production.
# Renseigner des identifiants Twilio ne suffit PAS à activer les envois réels
# en local — mettre SMS_DRIVER=twilio pour cela.
SMS_DRIVER=
# Les trois sont requis par le driver twilio ; sans eux il retombe sur `log`
# plutôt que d'empêcher l'application de démarrer.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Stripe ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── OAuth Social Providers ────────────────────────
# ⚠ OBLIGATOIRE — le repli silencieux sur JWT_SECRET a été SUPPRIMÉ.
# Secret de signature du cookie d'état OAuth (protection CSRF du parcours
# « se connecter avec Google/LinkedIn/Facebook »).
#
# Sans cette variable, l'application NE DÉMARRE PLUS dès qu'une stratégie
# OAuth est chargée — y compris en local. C'est délibéré : le repli
# précédent faisait qu'une même clé signait des jetons de session ET un état
# OAuth éphémère, si bien que la rotation de JWT_SECRET (geste normal, qui
# « ne fait que » déconnecter tout le monde) cassait au passage les
# connexions sociales en cours, sans que rien ne relie l'effet à sa cause.
# Et rien, au démarrage, ne distinguait un déploiement configuré d'un
# déploiement qui retombait sur JWT_SECRET.
# Valeur DISTINCTE de JWT_SECRET : openssl rand -hex 32
OAUTH_STATE_SECRET=change-me-to-a-long-random-secret-DIFFERENT-de-JWT_SECRET
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

LINKEDIN_CLIENT_ID=xxx
LINKEDIN_CLIENT_SECRET=xxx
LINKEDIN_CALLBACK_URL=http://localhost:3001/auth/linkedin/callback

# Facebook OAuth (strategie passport-facebook, requise au demarrage du module IAM)
FACEBOOK_APP_ID=xxx
FACEBOOK_APP_SECRET=xxx
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# ── App ───────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Les trois URLs sont lues à plusieurs endroits : CORS HTTP et CORS WebSocket
# (main.ts, notification.gateway.ts), politique CSP Helmet, liens des emails.
# ⚠ Les origines CORS du WebSocket sont figées à l'IMPORT du module : c'est la
# raison pour laquelle main.ts charge dotenv en toute première ligne.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# URL publique de l'API elle-même (liens d'email, repli du logo MFA).
API_URL=http://localhost:3001
TFA_APP_NAME=BeOwn
# Nom affiché dans l'application authenticator. MFA_APP_NAME est le nom
# courant ; TFA_APP_NAME reste accepté comme repli historique.
MFA_APP_NAME=BeOwn

# ── Documentation d'API (Swagger) ─────────────────
# FERMÉE par défaut : la doc n'est exposée sur /api/docs que si cette variable
# vaut exactement `true`. Elle publie la cartographie complète des routes et
# des payloads — à n'activer que temporairement, jamais sur un environnement
# joignable depuis Internet.
SWAGGER_ENABLED=false

# ── Durées de vie de jetons supplémentaires ───────
# Lien de désabonnement des emails (en secondes ; défaut du code : 7776000,
# soit 90 jours). Long par nature : le lien doit rester valable dans une boîte
# mail consultée des mois plus tard.
JWT_TOKEN_UNSUBSCRIBE_TTL=7776000
# DEV UNIQUEMENT — envoie le QR code d'enrôlement TOTP par email (visible dans
# Mailpit), parce qu'un client HTTP comme Postman ne sait pas dessiner l'URI
# otpauth://. Le message transporte le secret en clair : à laisser sur false
# partout ailleurs qu'en local. Ignoré si NODE_ENV=production.
TOTP_QR_EMAIL=false
# URL PUBLIQUE du logo affiché en vignette du compte dans les applications
# authenticator (paramètre `image` de l'URI otpauth). Facultative : sans elle,
# on retombe sur API_URL + /images/beown_logo_circle.png, et si API_URL manque
# aussi, aucun paramètre n'est ajouté. Elle est téléchargée par le téléphone de
# l'utilisateur : une adresse en localhost ne résoudra pas depuis un mobile.
MFA_LOGO_URL=
# ⚠ OBLIGATOIRE — clé de chiffrement AES-GCM des secrets TOTP stockés en base.
# Le repli silencieux sur JWT_SECRET a été SUPPRIMÉ : sans cette variable,
# toute opération TOTP échoue désormais bruyamment. Avec l'ancien repli, la
# rotation de JWT_SECRET rendait ILLISIBLES tous les secrets TOTP en base —
# tous les utilisateurs perdaient leur second facteur d'un coup, sans signal.
# openssl rand -hex 32, valeur DISTINCTE de JWT_SECRET :
MFA_SECRET_ENCRYPTION_KEY=change-me-to-a-32-byte-random-secret
# Nom historique, conservé UNIQUEMENT comme clé de LECTURE (voir ci-dessous).
TFA_SECRET_ENCRYPTION_KEY=change-me-to-a-32-byte-random-secret
# Fenêtre de compatibilité pour les secrets TOTP DÉJÀ chiffrés avec l'ancienne
# clé (TFA_SECRET_ENCRYPTION_KEY, ou JWT_SECRET via l'ancien repli).
#   true (défaut) : la LECTURE réessaie avec les anciennes clés encore
#     présentes dans l'environnement. L'ÉCRITURE utilise toujours
#     MFA_SECRET_ENCRYPTION_KEY, si bien que chaque ré-enrôlement de facteur
#     fait basculer le secret sur la nouvelle clé.
#   false : lecture legacy fermée. À ne poser qu'une fois tous les facteurs
#     ré-enrôlés ou une rotation hors ligne effectuée — sinon les seconds
#     facteurs concernés deviennent inutilisables.
MFA_LEGACY_KEY_FALLBACK=true

# ─── Stockage des médias (Cloudinary) ────────────────────
# CLOUDINARY_CLOUD_NAME est lu avec `getOrThrow` : son absence empêche le
# démarrage de l'application (et non un simple mode dégradé).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Signature électronique (Yousign) ────────────────────
# Sans YOUSIGN_API_KEY, l'appel part avec une clé vide : la signature de
# contrat échoue côté fournisseur, pas au démarrage.
YOUSIGN_API_KEY=
# ⚠ FAIL-CLOSED : sans YOUSIGN_WEBHOOK_SECRET, POST /webhooks/yousign refuse
# TOUT appel en 401 — l'authenticité ne pouvant pas être établie, aucune
# signature n'est finalisée et aucune cession n'est réglée. Renseignez le
# secret du webhook fourni par Yousign sur tout environnement réellement
# branché au prestataire. (Auparavant, un secret vide faisait accepter
# n'importe quel appel sur cette route publique.)
YOUSIGN_WEBHOOK_SECRET=
# Défaut du code : l'environnement SANDBOX. ⚠ À basculer sur l'URL de
# production (https://api.yousign.app/v3) au go-live, sinon les contrats sont
# signés dans un bac à sable et n'ont aucune valeur.
YOUSIGN_BASE_URL=https://api-sandbox.yousign.app/v3
YOUSIGN_TIMEOUT_MS=10000

# ─── Surveillance LCB-FT (AML) ───────────────────────────
# Seuils d'alerte en EUR (défauts du code : 10000 / 50000).
# ⚠ Valeurs techniques, à arbitrer avec le responsable conformité — voir le
# commentaire de k8s/base/configmap.yaml.
AML_THRESHOLD_SINGLE=10000
AML_THRESHOLD_MONTHLY=50000

# ─── PSFP / Regulation ───────────────────────────────────
PLAFOND_INVESTISSEMENT_NON_AVERTI_EUR=1000
PLAFOND_INVESTISSEMENT_AVERTI_EUR=100000

# ─── KYC / Compliance ────────────────────────────────────
KYC_PROVIDER=stripe  # stripe (Stripe Identity) | manual (fallback validé par l'admin)

# ─── Observabilité (monitoring managé — Grafana Cloud EU / Sentry EU) ────
# Toutes optionnelles : SDK en no-op si la variable est absente (dev/CI sans
# collecteur). Voir DOC/MONITORING_SETUP.md pour le provisioning SaaS.
LOG_LEVEL=info
# Endpoint OTLP/HTTP de Grafana Alloy in-cluster (traces). Vide = tracing désactivé.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.monitoring.svc.cluster.local:4317
OTEL_SERVICE_NAME=beown-api
# Attribut `service.version` des traces (défaut du code : 1.0.0). À alimenter
# avec le SHA de commit par la CI, comme SENTRY_RELEASE, pour rattacher une
# trace à une version précise.
OTEL_SERVICE_VERSION=
OTEL_DEPLOYMENT_ENVIRONMENT=development
# DSN région UE (o<org>.ingest.de.sentry.io). Vide = Sentry désactivé.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release Sentry = SHA de commit (posé par la CI), pour corréler build/déploiement.
SENTRY_RELEASE=
# Jeton Bearer exigé sur GET /metrics.
#
# ⚠ À RENSEIGNER SUR TOUT ENVIRONNEMENT EXPOSÉ, pas seulement en production.
# Le code ne ferme la porte automatiquement que si NODE_ENV=production
# (metrics.controller.ts::assertAuthorized, OBS-1) : sur dev, staging et test —
# qui sont eux aussi joignables depuis Internet — un jeton ABSENT rend
# /metrics PUBLIC. Or les métriques exposent la volumétrie, les routes, les
# taux d'erreur et le rythme réel de la plateforme.
# Tant que le contrôleur n'aura pas été durci (condition à élargir à « tout
# environnement déployé »), c'est la configuration qui doit garantir la
# fermeture : renseigner ce jeton dans le Secret de CHAQUE namespace.
# Doit être IDENTIQUE au secret `beown-metrics-token` du namespace
# `monitoring` consommé par Alloy.
METRICS_TOKEN=change-me-to-a-long-random-secret

# ─── Google reCAPTCHA (protège POST /auth/sign-up) ───────
RECAPTCHA_SECRET_KEY=change_me
# Mettre `false` pour désactiver la vérification en développement local.
# Le flag est ignoré quand NODE_ENV=production (erreur loguée au démarrage).
RECAPTCHA_ENABLED=true

# ─── Parrainage (vague C) ────────────────────────────────────────────────────
# Pourcentage du PREMIER investissement définitif du filleul versé à CHACUN
# des deux bénéficiaires (parrain et filleul), et plafond de bonus par
# bénéficiaire et par année civile. Valeur absente/invalide → défauts (1 / 1500).
PARRAINAGE_TAUX_PCT=1
PARRAINAGE_PLAFOND_ANNUEL_EUR=1500
