# ── Database ──────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
DATABASE_DB=beown

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Project share token (random 32-byte hex; rotate to invalidate all existing share links) ──
PROJECT_SHARE_SECRET=change-me-to-a-long-random-hex

# ── JWT ───────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TOKEN_AUDIENCE=localhost:3001
JWT_TOKEN_ISSUER=localhost:3001
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
# In seconds. 86400 = 24h — matches the real deployed value (see .env) and
# the "email-token TTL is at most 24h" assumption baked into the
# email_verify/password_reset token-confusion guards (reset-password.usecase.ts,
# verify-email.service.ts).
JWT_TOKEN_EMAIL_TTL=86400

# ── OTP (2FA login codes — otp.controller.ts) ─────
OTP_TTL=30 # in seconds
MAX_ATTEMPTS=5

# ── Mail : trois drivers ──────────────────────────
# `mailpit`    dev : capture tout, rien ne sort
# `nodemailer` SMTP réel (variables MAIL_HOST/PORT/USER/USER_PASSWORD)
# `brevo`      API HTTP Brevo — implémenté mais compte non opérationnel
# Vide = auto : nodemailer si NODE_ENV vaut development, staging ou production
# (environnements déployés), mailpit partout ailleurs — dont le poste local,
# qui ne définit pas NODE_ENV.
MAIL_DRIVER=
# API HTTP de Mailpit — doit correspondre au port publié par docker-compose.
MAILPIT_URL=http://localhost:8025

# ── SMTP (driver nodemailer) ─────────────────────
# Port 465 = TLS implicite, 587 = STARTTLS. Sur Gmail, MAIL_USER_PASSWORD doit
# être un « mot de passe d'application », pas le mot de passe du compte.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_USER_PASSWORD=
# Expéditeur des drivers mailpit et nodemailer (brevo utilise
# BREVO_SENDER_EMAIL). Écrasé par l'expéditeur configuré côté admin s'il existe.
MAIL_FROM=no-reply@beown.local
MAIL_FROM_NAME=BeOwn

# ── Brevo (Sendinblue) ───────────────────────────
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=no-reply@beown.fr
BREVO_SENDER_NAME=BeOwn

# ── SMS : deux drivers ────────────────────────────
# `log` (dev : rien ne sort, le code OTP est écrit dans les logs) | `twilio`
# (envois réels, facturés).
# Vide = auto : log hors production, twilio si NODE_ENV=production.
# Renseigner des identifiants Twilio ne suffit PAS à activer les envois réels
# en local — mettre SMS_DRIVER=twilio pour cela.
SMS_DRIVER=
# Les trois sont requis par le driver twilio ; sans eux il retombe sur `log`
# plutôt que d'empêcher l'application de démarrer.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Stripe ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── OAuth Social Providers ────────────────────────
# Optional: dedicated secret for signing the OAuth state cookie (CSRF protection).
# If unset, falls back to JWT_SECRET.
# OAUTH_STATE_SECRET=change-me-to-a-long-random-secret
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

FACEBOOK_CLIENT_ID=xxx
FACEBOOK_CLIENT_SECRET=xxx
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

LINKEDIN_CLIENT_ID=xxx
LINKEDIN_CLIENT_SECRET=xxx
LINKEDIN_CALLBACK_URL=http://localhost:3001/auth/linkedin/callback

# ── App ───────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
TFA_APP_NAME=BeOwn
# DEV UNIQUEMENT — envoie le QR code d'enrôlement TOTP par email (visible dans
# Mailpit), parce qu'un client HTTP comme Postman ne sait pas dessiner l'URI
# otpauth://. Le message transporte le secret en clair : à laisser sur false
# partout ailleurs qu'en local. Ignoré si NODE_ENV=production.
TOTP_QR_EMAIL=false
# URL PUBLIQUE du logo affiché en vignette du compte dans les applications
# authenticator (paramètre `image` de l'URI otpauth). Facultative : sans elle,
# on retombe sur API_URL + /images/beown_logo_circle.png, et si API_URL manque
# aussi, aucun paramètre n'est ajouté. Elle est téléchargée par le téléphone de
# l'utilisateur : une adresse en localhost ne résoudra pas depuis un mobile.
MFA_LOGO_URL=
TFA_SECRET_ENCRYPTION_KEY=change-me-to-a-32-byte-random-secret

# ─── PSFP / Regulation ───────────────────────────────────
PLAFOND_INVESTISSEMENT_NON_AVERTI_EUR=1000
PLAFOND_INVESTISSEMENT_AVERTI_EUR=100000

# ─── KYC / Compliance ────────────────────────────────────
KYC_PROVIDER=stripe  # stripe (Stripe Identity) | manual (fallback validé par l'admin)

# ─── Google reCAPTCHA (protège POST /auth/sign-up) ───────
RECAPTCHA_SECRET_KEY=change_me
# Mettre `false` pour désactiver la vérification en développement local.
# Le flag est ignoré quand NODE_ENV=production (erreur loguée au démarrage).
RECAPTCHA_ENABLED=true
