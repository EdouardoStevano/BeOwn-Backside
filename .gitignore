/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
.claude/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
.env.*
# fichiers env à nom non standard (.staging.env, .test.env, prod.env, ...)
*.env
!.env.example

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Redis dump (état local : hachages OTP, sessions refresh, compteurs rate-limit)
dump.rdb

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.worktrees/

# Secrets Kubernetes — ne jamais committer de vraies valeurs (garder uniquement *.example.yaml)
k8s/02-secrets.yaml
k8s/base/secrets.yaml
k8s/**/secrets.yaml
# Couvre aussi les Secrets préfixés (backup-secrets.yaml…), que le motif
# ci-dessus laissait passer. `*.example.yaml` reste versionné : le suffixe
# `example` empêche la correspondance avec `*secrets.yaml`.
k8s/**/*secrets.yaml
!k8s/**/*secrets.example.yaml
# L'Ingress est désormais VERSIONNÉ (k8s/base/ingress.yaml + patches par
# overlay). Cette ligne ne concerne plus qu'un éventuel fichier historique
# resté sur un poste.
k8s/06-ingress.yaml