<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Échéance à venir</title>
<style>body{margin:0;padding:0;background:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}.wrap{max-width:560px;margin:40px auto;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.07)}.header{background:#1A2E35;padding:32px 40px;text-align:center}.logo{color:#FFB52E;font-size:26px;font-weight:800}.body{padding:40px}.h1{font-size:22px;font-weight:700;color:#1A2E35;margin:0 0 12px}.p{font-size:15px;color:#64748b;line-height:1.6;margin:0 0 20px}.amount{background:#1A2E35;color:#fff;border-radius:12px;padding:24px;text-align:center;margin-bottom:24px}.amount-label{font-size:12px;opacity:.6;margin-bottom:6px}.amount-value{font-size:32px;font-weight:800;color:#FFB52E}.card{background:#f8fafc;border-radius:12px;padding:20px;margin-bottom:24px}.row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f1f5f9}.row:last-child{border:none}.label{font-size:13px;color:#64748b}.value{font-size:14px;font-weight:700;color:#1A2E35}.footer{background:#f8fafc;padding:20px 40px;text-align:center;font-size:12px;color:#94a3b8}</style></head>
<body><div class="wrap">
  <div class="header"><div class="logo">BeOwn</div></div>
  <div class="body">
    <p class="h1">Bonjour {{prenom}},</p>
    <p class="p">Un versement est prévu sur votre investissement dans le projet <strong>{{projetTitre}}</strong>.</p>
    <div class="amount">
      <div class="amount-label">Montant prévu</div>
      <div class="amount-value">{{montant}} FCFA</div>
    </div>
    <div class="card">
      <div class="row"><span class="label">Date prévue</span><span class="value">{{date}}</span></div>
      <div class="row"><span class="label">Projet</span><span class="value">{{projetTitre}}</span></div>
    </div>
  </div>
  <div class="footer">© BeOwn — Investissement immobilier fractionné</div>
</div></body></html>
