<!DOCTYPE html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Retrait en cours</title>
<style>body{margin:0;padding:0;background:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}.wrap{max-width:560px;margin:40px auto;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.07)}.header{background:#1A2E35;padding:32px 40px;text-align:center}.logo{color:#FFB52E;font-size:26px;font-weight:800}.body{padding:40px}.badge{background:#dbeafe;border-radius:50%;width:64px;height:64px;margin:0 auto 24px;font-size:32px;display:flex;align-items:center;justify-content:center}.h1{font-size:22px;font-weight:700;color:#1A2E35;margin:0 0 12px;text-align:center}.amount{background:#1A2E35;color:#fff;border-radius:12px;padding:24px;text-align:center;margin-bottom:24px}.amount-label{font-size:12px;opacity:.6;margin-bottom:6px}.amount-value{font-size:32px;font-weight:800;color:#FFB52E}.p{font-size:15px;color:#64748b;line-height:1.6;margin:0 0 20px;text-align:center}.footer{background:#f8fafc;padding:20px 40px;text-align:center;font-size:12px;color:#94a3b8}</style></head>
<body><div class="wrap">
  <div class="header"><div class="logo">BeOwn</div></div>
  <div class="body">
    <div class="badge">🏦</div>
    <p class="h1">Retrait en cours</p>
    <div class="amount">
      <div class="amount-label">Montant en traitement</div>
      <div class="amount-value">{{montant}}</div>
    </div>
    <p class="p">Bonjour {{prenom}}, votre demande de retrait est en cours de traitement. Les fonds seront versés sur votre compte bancaire sous 2 à 5 jours ouvrés.</p>
  </div>
  <div class="footer">© BeOwn — Investissement immobilier fractionné</div>
</div></body></html>
